/node_modules/
/.rpt2_cache/
/dist
.idea

# Playwright: reports, per-run output and the downloaded browser builds.
/playwright-report/
/test-results/
/.playwright/
/ms-playwright/

# End-to-end Home Assistant instance
/test/e2e/ha/config/.storage/
/test/e2e/ha/config/home-assistant*.log*
/test/e2e/ha/config/.cloud/
/test/e2e/.auth/
/test/e2e/artifacts/
/test/artifacts/

# Home Assistant runtime state (the authored fixture files are re-included below)
/test/e2e/ha/config/*
!/test/e2e/ha/config/configuration.yaml
!/test/e2e/ha/config/e2e-yaml-dashboard.yaml
!/test/e2e/ha/config/map_fixture.png
!/test/e2e/ha/config/custom_components/
/test/e2e/ha/config/custom_components/*
!/test/e2e/ha/config/custom_components/map_fixture/
# Python bytecode
__pycache__/
*.pyc

# Demo-video Home Assistant (scripts/demo-video): only the authored config is committed
/scripts/demo-video/.auth/
/scripts/demo-video/out/
/scripts/demo-video/ha/config/*
!/scripts/demo-video/ha/config/configuration.yaml
!/scripts/demo-video/ha/config/custom_components/
