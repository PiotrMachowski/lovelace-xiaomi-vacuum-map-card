        "xiaomi",
        "roborock",
        "valetudo",
        "hacs"
    ],
    "module": "xiaomi-vacuum-map-card.js",
    "repository": "https://github.com/Igloczek/lovelace-better-xiaomi-vacuum-map-card.git",
